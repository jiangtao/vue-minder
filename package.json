{
  "name": "vue-minder",
  "version": "3.0.0",
  "description": "Vue Kityminder - Vue 3 version",
  "main": "dist/minder.min.js",
  "module": "dist/minder.es.js",
  "exports": {
    ".": {
      "import": "./dist/minder.es.js",
      "require": "./dist/minder.min.js"
    }
  },
  "scripts": {
    "dev": "npm run build:style && vite",
    "build": "npm run build:style && vite build",
    "build:style": "gulp --gulpfile build/build-style.js",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "bootstrap": "^3.4.1",
    "core-js": "^2.4.1",
    "hotbox": "fex-team/hotbox",
    "kity": "^2.0.4",
    "kityminder-core": "github:jiangtao/kityminder-core",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "gulp": "^4.0.2",
    "gulp-autoprefixer": "^7.0.1",
    "gulp-clean-css": "^4.3.0",
    "gulp-less": "^4.0.1",
    "gulp-rename": "^2.0.0",
    "vite": "^5.0.0",
    "vue": "^3.4.0"
  }
}
